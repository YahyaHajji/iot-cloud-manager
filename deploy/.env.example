
# PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=CHANGE_ME

# MQTT
MQTT_USERNAME=iot-backend
MQTT_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# ADMIN initial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Frontend
CORS_ALLOWED_ORIGINS=https://iot-manager-yahya.duckdns.org

# E-mail d'alerte (remplacer les valeurs factices dans .env)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=project@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
ALERT_EMAIL_TO=recipient@example.com

# URL publique de l'API vue par le navigateur (build du frontend)
VITE_API_BASE_URL=https://iot-manager-yahya.duckdns.org

# Grafana (supervision)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Simulateur de capteurs (un mot de passe MQTT différent par capteur, sur une seule ligne)
SIMULATOR_SENSORS=[{"deviceId":"sensor-room-01","intervalSec":5,"password":"CHANGE_ME"},{"deviceId":"sensor-room-02","intervalSec":10,"password":"CHANGE_ME"}]
HEARTBEAT_INTERVAL_SEC=30
# 0 = désactivé ; 5 = une température de 45 °C toutes les 5 mesures (démonstration des alertes)
ANOMALY_EVERY_N=0
