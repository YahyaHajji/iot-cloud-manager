
# PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=CHANGE_ME

# MQTT
MQTT_USERNAME=iot-backend
MQTT_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# ADMIN initial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Frontend
CORS_ALLOWED_ORIGINS=https://iot-manager-yahya.duckdns.org

# URL publique de l'API vue par le navigateur (build du frontend)
VITE_API_BASE_URL=https://iot-manager-yahya.duckdns.org

# Grafana (supervision)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
